{
  "name": "smartpot-web-solid",
  "private": true,
  "version": "2.0.0",
  "description": "PWA de SmartPot en SolidJS para monitorear y automatizar cultivos hidropónicos",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
