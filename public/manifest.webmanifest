{
  "id": "/",
  "name": "SmartPot",
  "short_name": "SmartPot",
  "description": "Monitoreo y automatización de cultivos hidropónicos con IoT e inteligencia artificial.",
  "lang": "es",
  "dir": "ltr",
  "start_url": "/app",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "any",
  "background_color": "#0B3D2B",
  "theme_color": "#0B3D2B",
  "categories": ["lifestyle", "productivity", "utilities"],
  "icons": [
    { "src": "/icons/app-icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" },
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "/icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Panel general", "url": "/app", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Mis cultivos", "url": "/app/crops", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Control general", "url": "/app/control", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Alertas", "url": "/app/notifications", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
